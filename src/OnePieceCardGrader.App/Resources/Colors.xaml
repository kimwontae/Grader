<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#FF12141A</Color>
    <Color x:Key="SurfaceColor">#FF1B1F2A</Color>
    <Color x:Key="SurfaceAltColor">#FF242A38</Color>
    <Color x:Key="AccentColor">#FFC9A227</Color>
    <Color x:Key="TextColor">#FFE8E6E1</Color>
    <Color x:Key="MutedColor">#FF9AA3B2</Color>
    <Color x:Key="DangerColor">#FFD45D5D</Color>
    <Color x:Key="SuccessColor">#FF5DAB7A</Color>
    <Color x:Key="BorderColor">#FF343B4A</Color>
    <Color x:Key="TraceColor">#FF8FAADC</Color>
    <Color x:Key="MinorColor">#FF7BC67E</Color>
    <Color x:Key="ModerateColor">#FFE0C36A</Color>
    <Color x:Key="MajorColor">#FFE0894A</Color>
    <Color x:Key="SevereColor">#FFD45D5D</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TraceBrush" Color="{StaticResource TraceColor}" />
    <SolidColorBrush x:Key="MinorBrush" Color="{StaticResource MinorColor}" />
    <SolidColorBrush x:Key="ModerateBrush" Color="{StaticResource ModerateColor}" />
    <SolidColorBrush x:Key="MajorBrush" Color="{StaticResource MajorColor}" />
    <SolidColorBrush x:Key="SevereBrush" Color="{StaticResource SevereColor}" />
</ResourceDictionary>
