<UserControl x:Class="OnePieceCardGrader.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnePieceCardGrader.App.Controls"
             xmlns:converters="clr-namespace:OnePieceCardGrader.App.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:NullToVisibilityConverter x:Key="NullVis" />
        <converters:PathToImageConverter x:Key="PathImg" />
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="12,10">
            <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="이전" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Command="{Binding BackCommand}" />
                <Button Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NextCommand}" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding StepTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsInfoStep, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Card Name 외 항목은 선택 사항입니다." Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                            <TextBlock Text="Card Name *" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CardName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Card Number (예: OP05-119)" Margin="0,12,0,4" />
                            <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Set" Margin="0,12,0,4" />
                            <TextBox Text="{Binding SetName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Language" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Rarity" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Rarity, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Memo" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />
                            <Button Content="사진 촬영 가이드" Style="{StaticResource GhostButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Click="OnPhotoGuide" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Visibility="{Binding IsPhotoStep, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <controls:ImageDropSlot Grid.Column="0" Title="Front 전체사진" ImagePath="{Binding FrontImagePath, Mode=TwoWay}" Margin="0,0,8,0" />
                        <controls:ImageDropSlot Grid.Column="1" Title="Back 전체사진" ImagePath="{Binding BackImagePath, Mode=TwoWay}" Margin="8,0,0,0" />
                    </Grid>

                    <Grid Visibility="{Binding IsDetectionStep, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="자동 감지" Style="{StaticResource GhostButton}" Command="{Binding AutoDetectCommand}" Margin="0,0,8,0" />
                                <Button Content="초기화" Style="{StaticResource GhostButton}" Command="{Binding ResetCornersCommand}" Margin="0,0,8,0" />
                                <Button Content="적용" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyDetectionCommand}" />
                                <TextBlock Text="네 점을 카드 귀퉁이에 맞추세요." Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Ctrl+마우스 휠로 사진을 확대한 뒤 점을 더 정밀하게 옮길 수 있습니다. 확대 후 휠은 상하, Shift+휠은 좌우, 가운데 버튼 드래그는 화면 이동입니다. 가로·세로 스크롤은 사진 화면 가장자리에 고정됩니다." />
                        </StackPanel>
                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabItem Header="Front">
                                <controls:QuadEditorControl ImagePath="{Binding FrontImagePath}"
                                                            Corners="{Binding FrontCorners, Mode=TwoWay}"
                                                            ImageWidthPx="{Binding FrontPreview.Detection.ImageWidth}"
                                                            ImageHeightPx="{Binding FrontPreview.Detection.ImageHeight}" />
                            </TabItem>
                            <TabItem Header="Back">
                                <controls:QuadEditorControl ImagePath="{Binding BackImagePath}"
                                                            Corners="{Binding BackCorners, Mode=TwoWay}"
                                                            ImageWidthPx="{Binding BackPreview.Detection.ImageWidth}"
                                                            ImageHeightPx="{Binding BackPreview.Detection.ImageHeight}" />
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <Grid Visibility="{Binding IsCenteringStep, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="자동 센터링 분석 신뢰도가 낮습니다. 가이드를 확인해 주세요."
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding LowCenteringConfidence, Converter={StaticResource BoolVis}}"
                                   Margin="0,0,0,8" />
                        <Expander Grid.Row="1" Header="센터링 영역은 이렇게 지정하세요" IsExpanded="True" Margin="0,0,0,10"
                                  Foreground="{StaticResource TextBrush}">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="이 사진은 앞 단계에서 맞춘 카드 바깥선 기준으로 이미 잘려 있습니다. 화면의 네 끝은 카드 컷(실물 테두리)이고, 초록색 네 줄은 카드 바깥선이 아니라 그 안의 인쇄면입니다." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="인쇄면이란 아트/컬러 보더가 시작되는 안쪽 프레임입니다. 왼쪽·오른쪽 세로줄과 위·아래 가로줄을 각각 드래그해, 흰색/색 보더가 카드 여백에서 인쇄로 바뀌는 경계에 정확히 붙이세요. 카드 바깥 테두리에 맞추면 센터링이 항상 50/50으로 나옵니다." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="프로그램은 「카드 끝 ↔ 인쇄면」 사이 여백만 재서 좌/우, 상/하 비율을 계산합니다. 50/50이면 정중앙이고, PSA 10 전면 기준은 대략 55/45 이내입니다. 위에 표시되는 L/R, T/B 숫자가 지금 지정한 영역으로 바로 다시 계산됩니다." />
                                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                               Text="정밀 조정: Ctrl+마우스 휠로 확대 → 보더 라인에 초록 줄을 붙입니다. 확대 후 휠은 상하 이동, Shift+휠은 좌우 이동, 가운데 버튼 드래그는 화면 이동입니다. 가로 스크롤은 사진 화면 하단에 바로 있습니다." />
                                </StackPanel>
                            </Border>
                        </Expander>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="맞춤" Style="{StaticResource GhostButton}" Command="{Binding SetZoomCommand}" CommandParameter="1" Margin="0,0,6,0" />
                            <Button Content="200%" Style="{StaticResource GhostButton}" Command="{Binding SetZoomCommand}" CommandParameter="2" Margin="0,0,6,0" />
                            <Button Content="400%" Style="{StaticResource GhostButton}" Command="{Binding SetZoomCommand}" CommandParameter="4" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding FrontRatioText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding BackRatioText}" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <TabControl Grid.Row="3" Background="Transparent">
                            <TabItem Header="Front">
                                <controls:CenteringGuideControl ImagePath="{Binding FrontPreview.NormalizedPath}"
                                                                Guide="{Binding FrontGuide, Mode=TwoWay}"
                                                                Zoom="{Binding Zoom, Mode=TwoWay}" />
                            </TabItem>
                            <TabItem Header="Back">
                                <controls:CenteringGuideControl ImagePath="{Binding BackPreview.NormalizedPath}"
                                                                Guide="{Binding BackGuide, Mode=TwoWay}"
                                                                Zoom="{Binding Zoom, Mode=TwoWay}" />
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <Grid Visibility="{Binding IsCornerStep, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                                   Text="선택 사항입니다. 확대 사진을 올린 뒤, 네 점을 드래그해 카드 모서리 영역을 지정하세요. 지정한 영역만 잘라 분석합니다. Ctrl+휠로 확대해 더 정밀하게 맞출 수 있고, Shift+휠은 좌우, 가운데 버튼 드래그는 화면 이동입니다." />
                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabItem Header="좌상단">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="영역 초기화" Style="{StaticResource GhostButton}"
                                                Command="{Binding ResetCornerQuadCommand}" CommandParameter="TopLeft"
                                                Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <controls:ImageDropSlot CompactMode="True" Title="좌상단 확대 사진"
                                                                ImagePath="{Binding FrontCornerTopLeftPath, Mode=TwoWay}" />
                                    </DockPanel>
                                    <controls:QuadEditorControl AllowImageReplace="True"
                                                                ImagePath="{Binding FrontCornerTopLeftPath, Mode=TwoWay}"
                                                                Corners="{Binding FrontCornerTopLeftCorners, Mode=TwoWay}"
                                                                ImageWidthPx="{Binding FrontCornerTopLeftWidth}"
                                                                ImageHeightPx="{Binding FrontCornerTopLeftHeight}" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="우상단">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="영역 초기화" Style="{StaticResource GhostButton}"
                                                Command="{Binding ResetCornerQuadCommand}" CommandParameter="TopRight"
                                                Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <controls:ImageDropSlot CompactMode="True" Title="우상단 확대 사진"
                                                                ImagePath="{Binding FrontCornerTopRightPath, Mode=TwoWay}" />
                                    </DockPanel>
                                    <controls:QuadEditorControl AllowImageReplace="True"
                                                                ImagePath="{Binding FrontCornerTopRightPath, Mode=TwoWay}"
                                                                Corners="{Binding FrontCornerTopRightCorners, Mode=TwoWay}"
                                                                ImageWidthPx="{Binding FrontCornerTopRightWidth}"
                                                                ImageHeightPx="{Binding FrontCornerTopRightHeight}" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="좌하단">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="영역 초기화" Style="{StaticResource GhostButton}"
                                                Command="{Binding ResetCornerQuadCommand}" CommandParameter="BottomLeft"
                                                Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <controls:ImageDropSlot CompactMode="True" Title="좌하단 확대 사진"
                                                                ImagePath="{Binding FrontCornerBottomLeftPath, Mode=TwoWay}" />
                                    </DockPanel>
                                    <controls:QuadEditorControl AllowImageReplace="True"
                                                                ImagePath="{Binding FrontCornerBottomLeftPath, Mode=TwoWay}"
                                                                Corners="{Binding FrontCornerBottomLeftCorners, Mode=TwoWay}"
                                                                ImageWidthPx="{Binding FrontCornerBottomLeftWidth}"
                                                                ImageHeightPx="{Binding FrontCornerBottomLeftHeight}" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="우하단">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="영역 초기화" Style="{StaticResource GhostButton}"
                                                Command="{Binding ResetCornerQuadCommand}" CommandParameter="BottomRight"
                                                Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <controls:ImageDropSlot CompactMode="True" Title="우하단 확대 사진"
                                                                ImagePath="{Binding FrontCornerBottomRightPath, Mode=TwoWay}" />
                                    </DockPanel>
                                    <controls:QuadEditorControl AllowImageReplace="True"
                                                                ImagePath="{Binding FrontCornerBottomRightPath, Mode=TwoWay}"
                                                                Corners="{Binding FrontCornerBottomRightCorners, Mode=TwoWay}"
                                                                ImageWidthPx="{Binding FrontCornerBottomRightWidth}"
                                                                ImageHeightPx="{Binding FrontCornerBottomRightHeight}" />
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsSurfaceStep, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                                       Text="선택 사항입니다. 정면/사광 사진을 올리면 스크래치·얼룩 후보를 더 안정적으로 봅니다. 없으면 전체 사진으로 보수적으로 분석합니다." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="220" />
                                    <RowDefinition Height="220" />
                                </Grid.RowDefinitions>
                                <controls:ImageDropSlot Grid.Row="0" Grid.Column="0" Title="Front 정면 (상처)" ImagePath="{Binding FrontSurfaceNormalPath, Mode=TwoWay}" Margin="0,0,8,8" />
                                <controls:ImageDropSlot Grid.Row="0" Grid.Column="1" Title="Front 사광" ImagePath="{Binding FrontSurfaceAngledPath, Mode=TwoWay}" Margin="8,0,0,8" />
                                <controls:ImageDropSlot Grid.Row="1" Grid.Column="0" Title="Back 정면" ImagePath="{Binding BackSurfaceNormalPath, Mode=TwoWay}" Margin="0,8,8,0" />
                                <controls:ImageDropSlot Grid.Row="1" Grid.Column="1" Title="Back 사광" ImagePath="{Binding BackSurfaceAngledPath, Mode=TwoWay}" Margin="8,8,0,0" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Visibility="{Binding IsProgressStep, Converter={StaticResource BoolVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                                <TextBlock Text="분석을 진행하고 있습니다"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center" />
                                <Grid Margin="0,16,0,8" Height="32">
                                    <ProgressBar Value="{Binding ProgressPercent}"
                                                 Maximum="100"
                                                 Style="{StaticResource AnalysisProgressBar}" />
                                    <Border Background="#99000000"
                                            CornerRadius="4"
                                            Padding="10,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="{Binding ProgressBarLabel}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ProgressMessage}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <Button Content="취소"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding CancelAnalysisCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0" />
                                <ItemsControl ItemsSource="{Binding AnalysisStages}" Margin="0,20,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding StatusText}"
                                                           Margin="12,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ProgressLog}" Margin="0,16,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Visibility="{Binding IsResultStep, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="0,0,12,0">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="PSA 예상 등급" Style="{StaticResource MutedText}" />
                                <TextBlock FontSize="72" FontWeight="Bold" Foreground="{StaticResource AccentBrush}">
                                    <Run Text="{Binding DisplayedGrading.PredictedGrade, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="예상 범위  PSA " />
                                    <Run Text="{Binding DisplayedGrading.GradeRangeMin, Mode=OneWay}" />
                                    <Run Text=" ~ " />
                                    <Run Text="{Binding DisplayedGrading.GradeRangeMax, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding WhatIfHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Margin="0,8,0,0">
                                    <Run Text="분석 신뢰도  " />
                                    <Run Text="{Binding DisplayedGrading.AnalysisConfidence, Mode=OneWay, StringFormat=F0}" />
                                    <Run Text=" / 100" />
                                </TextBlock>
                                <TextBlock Text="{Binding ConfidenceMeaning}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12" />
                                <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                            <TabControl>
                                <TabItem Header="Front Overlay">
                                    <Image Stretch="Uniform" Source="{Binding Result.Front.OverlayPath, Converter={StaticResource PathImg}}" />
                                </TabItem>
                                <TabItem Header="Back Overlay">
                                    <Image Stretch="Uniform" Source="{Binding Result.Back.OverlayPath, Converter={StaticResource PathImg}}" />
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="분석 점수" Style="{StaticResource SectionTitle}" />
                                <TextBlock>
                                    <Run Text="Centering  " />
                                    <Run Text="{Binding DisplayedGrading.Centering.ConditionScore, Mode=OneWay, StringFormat=F1}" />
                                    <Run Text=" / 100" />
                                </TextBlock>
                                <TextBlock Text="{Binding FrontRatioText}" Margin="0,4" />
                                <TextBlock Text="{Binding BackRatioText}" Style="{StaticResource MutedText}" />
                                <TextBlock Margin="0,12,0,4">
                                    <Run Text="Corners  " />
                                    <Run Text="{Binding DisplayedGrading.Corners.ConditionScore, Mode=OneWay, StringFormat=F1}" />
                                    <Run Text=" / 100" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Result.Corners.Corners}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2">
                                                <Run Text="{Binding Position, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding CombinedScore, Mode=OneWay, StringFormat=F0}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,12,0,4">
                                    <Run Text="Surface  " />
                                    <Run Text="{Binding DisplayedGrading.Surface.ConditionScore, Mode=OneWay, StringFormat=F1}" />
                                    <Run Text=" / 100" />
                                </TextBlock>
                                <TextBlock Margin="0,12,0,4">
                                    <Run Text="Edges  " />
                                    <Run Text="{Binding DisplayedGrading.Edges.ConditionScore, Mode=OneWay, StringFormat=F1}" />
                                    <Run Text=" / 100" />
                                </TextBlock>
                                <TextBlock Text="발견된 결함" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBlock Text="체크를 해제하면 그 결함이 없는 것으로 보고 왼쪽 예상 등급을 다시 계산합니다."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DefectItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" Padding="10" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8">
                                                <StackPanel>
                                                    <CheckBox IsChecked="{Binding IsCounted, Mode=TwoWay}">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding SeverityText}" Style="{StaticResource MutedText}" Margin="24,4,0,0" />
                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                    <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                                    <Image Source="{Binding ZoomImagePath, Converter={StaticResource PathImg}}"
                                                           Stretch="Uniform"
                                                           MaxHeight="240"
                                                           Margin="0,10,0,0"
                                                           Visibility="{Binding HasZoom, Converter={StaticResource BoolVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="PSA 10 제한 요인" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                                <ItemsControl ItemsSource="{Binding DisplayedExplanation.LimitReasons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Result.BlockingReason}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="다시 분석" Style="{StaticResource GhostButton}" Command="{Binding ReanalyzeCommand}" Margin="0,0,8,0" />
                                    <Button Content="JSON Export" Style="{StaticResource GhostButton}" Command="{Binding ExportJsonCommand}" />
                                </StackPanel>
                                <TextBlock Text="실제 PSA 등급 입력" Margin="0,16,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="80" x:Name="ActualGradeBox" />
                                    <Button Content="저장" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                            Command="{Binding SaveActualGradeCommand}"
                                            CommandParameter="{Binding Text, ElementName=ActualGradeBox}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
