<UserControl x:Class="OnePieceCardGrader.App.Views.StandardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="등급 기준" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="PSA 공개 센터링 가이드라인을 설정 파일(Profiles/psa.json)로 관리합니다. 이 값은 공식 심사 알고리즘이 아닙니다." />
            <TextBlock>
                <Run Text="Profile: " />
                <Run Text="{Binding Profile.Name, Mode=OneWay}" />
                <Run Text="  v" />
                <Run Text="{Binding Profile.Version, Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Profile.Centering}" Margin="0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,4">
                            <Run Text="PSA " />
                            <Run Text="{Binding Key, Mode=OneWay}" />
                            <Run Text="  FrontMax " />
                            <Run Text="{Binding Value.FrontMax, Mode=OneWay}" />
                            <Run Text="  BackMax " />
                            <Run Text="{Binding Value.BackMax, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="본 결과는 이미지 분석을 기반으로 한 PSA 예상 등급이며 실제 PSA 등급과 다를 수 있습니다."
                       TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
