<Window x:Class="OnePieceCardGrader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OnePieceCardGrader.App.ViewModels"
        xmlns:views="clr-namespace:OnePieceCardGrader.App.Views"
        Title="One Piece Card Grader"
        Width="1440"
        Height="920"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WizardViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StandardsViewModel}">
            <views:StandardsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ONE PIECE" FontSize="12" Style="{StaticResource MutedText}" />
                    <TextBlock Text="CARD GRADER" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" />
                    <RadioButton Style="{StaticResource NavButton}" Content="새 카드 분석" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="NewAnalysis" GroupName="Nav" />
                    <RadioButton Style="{StaticResource NavButton}" Content="분석 기록"
                                 Command="{Binding NavigateCommand}" CommandParameter="History" GroupName="Nav" />
                    <RadioButton Style="{StaticResource NavButton}" Content="등급 기준"
                                 Command="{Binding NavigateCommand}" CommandParameter="Standards" GroupName="Nav" />
                    <RadioButton Style="{StaticResource NavButton}" Content="설정"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings" GroupName="Nav" />
                    <RadioButton Style="{StaticResource NavButton}" Content="About"
                                 Command="{Binding NavigateCommand}" CommandParameter="About" GroupName="Nav" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="11"
                           Style="{StaticResource MutedText}" Text="본 결과는 이미지 분석을 기반으로 한 PSA 예상 등급이며 실제 PSA 등급과 다를 수 있습니다." />
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" Margin="20" />
    </Grid>
</Window>
