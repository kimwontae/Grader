<UserControl x:Class="OnePieceCardGrader.App.Controls.CenteringGuideControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnPreviewMouseWheel">
            <Grid x:Name="Stage" Width="800" Height="800">
                <Image x:Name="Photo" Stretch="Fill" />
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseLeftButtonDown="OnDown"
                        MouseMove="OnMove"
                        MouseLeftButtonUp="OnUp" />
            </Grid>
        </ScrollViewer>
        <Border Width="140" Height="140" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="#AA12141A"
                x:Name="MagnifierHost" IsHitTestVisible="False">
            <Image x:Name="Magnifier" Stretch="UniformToFill" />
        </Border>
    </Grid>
</UserControl>
